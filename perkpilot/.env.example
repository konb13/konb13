# PerkPilot environment
#
# Leave USE_MOCK_DATA=true to run the app entirely off the bundled in-memory
# dataset (no Supabase project required). Flip to false and fill in the URL +
# anon key to point the same data layer at a real Supabase backend.

EXPO_PUBLIC_USE_MOCK_DATA=true
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
