{
  "expo": {
    "name": "PerkPilot",
    "slug": "perkpilot",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "perkpilot",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0B1220"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.perkpilot.app"
    },
    "android": {
      "package": "com.perkpilot.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supabaseUrl": "",
      "supabaseAnonKey": "",
      "useMockData": true
    }
  }
}
