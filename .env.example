# ─── Reddit API ───────────────────────────────────────────────────────────────
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=ArticleBot/1.0 by YourUsername

# ─── X / Twitter API v2 ───────────────────────────────────────────────────────
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# ─── OpenAI (GPT-4o article writer + DALL-E 3 image generator) ───────────────
OPENAI_API_KEY=your_openai_api_key

# ─── Google Gemini (alternative image generator) ─────────────────────────────
GEMINI_API_KEY=your_gemini_api_key

# ─── WordPress / WPEngine ─────────────────────────────────────────────────────
WP_SITE_URL=https://yoursite.wpengine.com
WP_USERNAME=your_wp_username
WP_APP_PASSWORD=your_wp_application_password

# WPEngine SSH Gateway (for WP-CLI)
WPENGINE_INSTALL_NAME=your_install_name
WPENGINE_SSH_KEY_PATH=~/.ssh/id_rsa

# ─── Workflow Defaults ────────────────────────────────────────────────────────
# IMAGE_PROVIDER: dalle | gemini  (default: dalle)
IMAGE_PROVIDER=dalle
# ARTICLE_LANGUAGE: en, es, fr, de, etc.
ARTICLE_LANGUAGE=en
# TARGET_COUNTRY: US, UK, AU, CA, etc. (for GEO optimization)
TARGET_COUNTRY=US
