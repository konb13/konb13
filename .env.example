# ─── Reddit API ───────────────────────────────────────────────────────────────
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=ArticleBot/1.0 by YourUsername

# ─── X / Twitter API v2 ───────────────────────────────────────────────────────
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# ─── OpenAI (article writer + DALL-E 3 image fallback) ───────────────────────
OPENAI_API_KEY=your_openai_api_key
# OPENAI_MODEL: gpt-4o | gpt-4o-mini | gpt-4.1  (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# ─── Higgsfield (primary image generator) ────────────────────────────────────
HIGGSFIELD_API_KEY=your_higgsfield_api_key
HIGGSFIELD_SECRET=your_higgsfield_secret
HIGGSFIELD_ENDPOINT=https://platform.higgsfield.ai/v1/image/generate

# ─── Google Gemini (alternative image generator) ─────────────────────────────
GEMINI_API_KEY=your_gemini_api_key

# ─── Dental News Discovery (RSS/Atom feeds) ──────────────────────────────────
# Comma- or newline-separated feed URLs. Leave blank to use built-in dental defaults.
NEWS_FEEDS=
# Comma-separated keywords an item must contain (leave blank for dental defaults).
NEWS_KEYWORDS=

# ─── Writer Voice (sound like your current writers) ──────────────────────────
# VOICE_LEARN: 1 to learn style from your published posts, 0 to skip.
VOICE_LEARN=1
VOICE_SAMPLE_COUNT=8
VOICE_CACHE_HOURS=24
# VOICE_STYLE_GUIDE: optional manual style guide / sample text (takes priority).
VOICE_STYLE_GUIDE=

# ─── WordPress / WPEngine ─────────────────────────────────────────────────────
WP_SITE_URL=https://yoursite.wpengine.com
WP_USERNAME=your_wp_username
WP_APP_PASSWORD=your_wp_application_password
# WP_POST_STATUS: draft | pending | publish  (default: publish; use draft for review)
WP_POST_STATUS=draft

# WPEngine SSH Gateway (for WP-CLI)
WPENGINE_INSTALL_NAME=your_install_name
WPENGINE_SSH_KEY_PATH=~/.ssh/id_rsa

# ─── Workflow Defaults ────────────────────────────────────────────────────────
# IMAGE_PROVIDER: higgsfield | dalle | gemini  (default: higgsfield)
IMAGE_PROVIDER=higgsfield
# ARTICLE_LANGUAGE: en, es, fr, de, etc.
ARTICLE_LANGUAGE=en
# TARGET_COUNTRY: US, UK, AU, CA, etc. (for GEO optimization)
TARGET_COUNTRY=US
